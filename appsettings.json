{
  "Caption": {
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1/",
    "MaxTokens": 500
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/cartoons.db"
  },
  "Auth": {
    "Mode": "None",
    "HeaderName": "X-Remote-User"
  },
  "Share": {
    "PublicBaseUrl": null,
    "TokenTtlHours": 1,
    "MetadataTtlHours": 168,
    "SweepIntervalMinutes": 10
  },
  "Tag": {
    "SweepIntervalMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
