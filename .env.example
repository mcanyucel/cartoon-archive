# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and docker-ignored.

# --- Used by all compose files ---

# OpenAI API key for image captioning.
OPENAI_API_KEY=sk-...

# Optional. Pin a specific image tag from ghcr.io/mcanyucel/cartoon-archive.
# Defaults to "latest" if unset.
# APP_VERSION=0.1.0

# App-side authentication mode. Case-sensitive. Must be one of:
#   None            app trusts every request. Use for a private/LAN deploy, or
#                   when the proxy in front handles auth entirely (e.g. Caddy
#                   basic_auth in docker-compose.caddy.yml).
#   ReverseProxy    app requires an identity header on every non-public path.
#                   Use when running behind SSO (Authelia, Keycloak, oauth2-proxy).
# Note: written as one word, no space, no hyphen. Any other value silently
# falls back to None (so the app runs wide open). Double-check the spelling.
AUTH_MODE=None

# Header the app reads the user identity from when AUTH_MODE=ReverseProxy.
# MUST match whatever your proxy actually forwards. If it doesn't match, every
# authenticated request gets a 401 from the app.
# Common values by proxy:
#   Authelia            Remote-User
#   oauth2-proxy        X-Forwarded-User
#   nginx auth_request  X-Remote-User
#   Traefik forward-auth   Remote-User (varies by middleware config)
# The default below matches the app's built-in default and works if you have
# no proxy at all. Override it for the proxy you're actually using.
AUTH_HEADER_NAME=X-Remote-User

# Public URL where share links should point.
# Only needed for the bare-metal compose when running behind your own reverse proxy.
# The Caddy compose derives this from SITE_HOST automatically.
# SHARE_PUBLIC_BASE_URL=https://cartoons.example.com


# --- Used only by docker-compose.caddy.yml ---

# Public hostname Caddy binds to. For local HTTP-only testing, use e.g. ":8080".
SITE_HOST=cartoons.example.com

# Basic-auth credentials. Generate the bcrypt hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
# Paste the hash below verbatim. `.env` values are read literally by Docker
# Compose, so the leading $2a$... does not need escaping here.
BASIC_AUTH_USER=styx
BASIC_AUTH_HASH=$2a$14$replace_with_your_bcrypt_hash
