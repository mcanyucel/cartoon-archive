@page
@model UploadModel
@{
    ViewData["Title"] = "Upload";
}

<div class="row mb-4">
    <div class="col-md-6 mx-auto">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Upload</h5>
                <form id="upload-form">
                    <div class="mb-3">
                        <label for="file" class="form-label">Image</label>
                        <div id="drop-zone" class="border border-2 border-dashed rounded p-3 text-center">
                            <p class="text-muted small mb-2" id="drop-hint">Drop image here, or select a file</p>
                            <input type="file" class="form-control" id="file" name="File"
                                   accept="image/jpeg,image/png,image/webp">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="url" class="form-label">…or paste image URL</label>
                        <input type="url" class="form-control" id="url" name="Url"
                               placeholder="https://example.com/cartoon.jpg">
                    </div>
                    <div class="mb-3">
                        <label for="language" class="form-label">Language</label>
                        <select class="form-select" id="language" name="Language" required>
                            <option value="tr">Türkçe</option>
                            <option value="en">English</option>
                            <option value="de">Deutsch</option>
                            <option value="fr">Français</option>
                            <option value="es">Español</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Upload</button>
                    <div id="upload-status" class="mt-2 small"></div>
                    <div id="dup-warning" class="alert alert-warning mt-3 d-none">
                        <p class="mb-2"><strong>Similar images are already in the archive:</strong></p>
                        <div id="dup-thumbs" class="d-flex flex-wrap gap-2 mb-2"></div>
                        <div class="d-flex gap-2">
                            <a href="/" class="btn btn-sm btn-primary">Keep and go to gallery</a>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="dup-delete">Delete this upload</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
