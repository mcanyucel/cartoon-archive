@page
@model UploadModel
@{
    ViewData["Title"] = "Upload";
}

<div class="mx-auto" style="max-width: 32rem;">
    <h1 class="h4 mb-1">Add a drawing</h1>
    <p class="ka-meta mb-4">A caption is written automatically once it lands</p>

    <form id="upload-form">
        <div class="mb-4">
            <div id="drop-zone" class="ka-dropzone">
                <p class="small mb-3" id="drop-hint">Drop an image here, or choose a file</p>
                <input type="file" class="form-control form-control-sm" id="file" name="File"
                       accept="image/jpeg,image/png,image/webp" aria-label="Image file">
            </div>
        </div>

        <div class="mb-4">
            <label for="url" class="form-label small">…or paste an image URL</label>
            <input type="url" class="form-control" id="url" name="Url"
                   placeholder="https://example.com/cartoon.jpg">
        </div>

        <div class="mb-4">
            <label for="language" class="form-label small">Caption language</label>
            <select class="form-select" id="language" name="Language" required>
                <option value="tr">Türkçe</option>
                <option value="en">English</option>
                <option value="de">Deutsch</option>
                <option value="fr">Français</option>
                <option value="es">Español</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Upload</button>
        <div id="upload-status" class="mt-3 small"></div>

        <div id="dup-warning" class="alert alert-warning mt-4 d-none">
            <p class="mb-2"><strong>This looks like something already in the archive</strong></p>
            <div id="dup-thumbs" class="d-flex flex-wrap gap-2 mb-3"></div>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-sm btn-primary">Keep it</a>
                <button type="button" class="btn btn-sm btn-outline-danger" id="dup-delete">Discard this upload</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
