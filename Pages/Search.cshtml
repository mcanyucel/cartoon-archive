@page
@model SearchModel
@{
    ViewData["Title"] = "Search";
}

@if (!string.IsNullOrWhiteSpace(Model.Query))
{
    <h1 class="h4 mb-1">@Model.Query</h1>
    <p class="ka-meta mb-3" id="results-count"></p>
}
else
{
    <p class="ka-meta mb-3">Type a word from a caption or a tag</p>
}
<div id="results-status" class="small mb-2"></div>
<div id="search-results" class="masonry-gallery"></div>

@section Scripts {
    <script src="~/js/cartoon-card.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
}
