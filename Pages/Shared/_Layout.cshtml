<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Karikatür Arşivi</title>
    <script>
        // Apply theme before render to avoid FOUC.
        (function () {
            var stored = localStorage.getItem('theme');
            var theme = stored ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#1f6f6b" />
</head>
<body>
    @* Icon sprite. Inline SVG rather than an icon font: eight marks don't justify
       a dependency, and a <symbol> sheet costs no extra request. Text glyphs are
       deliberately not used - a glyph is positioned by its font baseline and side
       bearings, which is why chevrons never centre inside a circle. *@
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
        <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
        </symbol>
        <symbol id="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
        </symbol>
        <symbol id="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"></path>
        </symbol>
        <symbol id="i-dice" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="8.5" cy="8.5" r="1.4" fill="currentColor" stroke="none"></circle>
            <circle cx="15.5" cy="15.5" r="1.4" fill="currentColor" stroke="none"></circle>
            <circle cx="15.5" cy="8.5" r="1.4" fill="currentColor" stroke="none"></circle>
        </symbol>
        <symbol id="i-prev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 5.5L8 12l6.5 6.5"></path>
        </symbol>
        <symbol id="i-next" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.5 5.5L16 12l-6.5 6.5"></path>
        </symbol>
        <symbol id="i-first" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 5.5L10.5 12 17 18.5M10 5.5L3.5 12 10 18.5"></path>
        </symbol>
        <symbol id="i-last" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 5.5L13.5 12 7 18.5M14 5.5L20.5 12 14 18.5"></path>
        </symbol>
        <symbol id="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18"></path>
        </symbol>
        <symbol id="i-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="18" cy="5" r="2.6"></circle><circle cx="6" cy="12" r="2.6"></circle>
            <circle cx="18" cy="19" r="2.6"></circle><path d="M8.3 10.8l7.4-4.3M8.3 13.2l7.4 4.3"></path>
        </symbol>
        <symbol id="i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16M10 7V4.8h4V7M6.5 7l.9 12.2h9.2L17.5 7M10.5 10.5v6M13.5 10.5v6"></path>
        </symbol>
        <symbol id="i-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 20h4L19 9a2.3 2.3 0 0 0-3.2-3.2L5 16.6z"></path>
        </symbol>
        <symbol id="i-regen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 11.5A8 8 0 1 1 17.3 6"></path><path d="M20 4.5V10h-5.3"></path>
        </symbol>
        <symbol id="i-tag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 11V4.5H10l10 10-6.5 6.5z"></path>
            <circle cx="7.3" cy="7.3" r="1.3" fill="currentColor" stroke="none"></circle>
        </symbol>
        <symbol id="i-shuffle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6.5h3.6l3 4M3 17.5h3.6l9-13H20M14 17.5h6M17.3 14.4l3 3.1-3 3.1M17.3 1.3l3 3.2-3 3.1"></path>
        </symbol>
    </svg>

    <header>
        <nav class="navbar navbar-expand-sm sticky-top mb-4">
            <div class="container align-items-center gap-2">
                <a class="ka-brand me-2" asp-area="" asp-page="/Index">Karikatür Arşivi</a>
                <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex align-items-center gap-2">
                    <ul class="navbar-nav flex-row gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Upload">Upload</a>
                        </li>
                    </ul>
                    <form class="ka-search ms-sm-auto flex-grow-1 flex-sm-grow-0" role="search"
                          asp-page="/Search" method="get" style="max-width: 20rem;">
                        <svg aria-hidden="true"><use href="#i-search"></use></svg>
                        <input type="search" name="q" placeholder="Search captions…"
                               aria-label="Search captions" value="@Context.Request.Query["q"]">
                    </form>
                    <button type="button" class="ka-icon-btn" id="theme-toggle" aria-label="Toggle theme">
                        <svg id="theme-icon" aria-hidden="true"><use href="#i-moon"></use></svg>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 — Karikatür Arşivi</span>
            <span class="ka-meta">v@(AppInfo.Version)</span>
        </div>
    </footer>

    @* Viewer. Still a Bootstrap modal: bootstrap.Modal, shown.bs.modal and
       hidden.bs.modal all behave as before, so random-browse.js is untouched.
       Only the body is rebuilt - the drawing gets the frame, and everything else
       floats over it or slides up from the bottom. *@
    <div class="modal fade" id="cartoon-lightbox" tabindex="-1"
         aria-label="Cartoon viewer" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-body cartoon-lightbox-image-wrap">

                    <div class="ka-viewer-stage">
                        <img id="cartoon-lightbox-image" alt="">
                    </div>

                    <div class="ka-viewer-top">
                        <span class="ka-viewer-pos d-none" id="cartoon-lightbox-position"></span>
                        <span class="ka-viewer-pos" id="cartoon-lightbox-language"></span>
                        <span class="ka-viewer-pos d-none d-sm-inline" id="cartoon-lightbox-uploaded"></span>

                        <div class="ka-viewer-tools">
                            <div class="d-flex gap-1" id="cartoon-lightbox-desc-controls">
                                <button type="button" class="ka-ghost-btn" id="cartoon-lightbox-edit" aria-label="Edit description" title="Edit description">
                                    <svg aria-hidden="true"><use href="#i-edit"></use></svg>
                                </button>
                                <button type="button" class="ka-ghost-btn" id="cartoon-lightbox-regen" aria-label="Regenerate caption" title="Regenerate caption">
                                    <svg aria-hidden="true"><use href="#i-regen"></use></svg>
                                </button>
                                <button type="button" class="ka-ghost-btn" id="cartoon-lightbox-tags-edit" aria-label="Edit tags" title="Edit tags">
                                    <svg aria-hidden="true"><use href="#i-tag"></use></svg>
                                </button>
                            </div>
                            <div class="d-flex gap-1" id="cartoon-lightbox-actions">
                                <button type="button" class="ka-ghost-btn d-none" id="cartoon-lightbox-reshuffle" aria-label="Shuffle again" title="Shuffle again">
                                    <svg aria-hidden="true"><use href="#i-shuffle"></use></svg>
                                </button>
                                <button type="button" class="ka-ghost-btn" id="cartoon-lightbox-share" aria-label="Share" title="Share">
                                    <svg aria-hidden="true"><use href="#i-share"></use></svg>
                                </button>
                                <button type="button" class="ka-ghost-btn" id="cartoon-lightbox-delete" aria-label="Delete" title="Delete">
                                    <svg aria-hidden="true"><use href="#i-trash"></use></svg>
                                </button>
                                <button type="button" class="ka-ghost-btn" data-bs-dismiss="modal" aria-label="Close" title="Close">
                                    <svg aria-hidden="true"><use href="#i-close"></use></svg>
                                </button>
                            </div>
                            <div class="d-none align-items-center gap-2" id="cartoon-lightbox-confirm">
                                <span class="ka-viewer-pos">Delete?</span>
                                <button type="button" class="btn btn-danger btn-sm" id="cartoon-lightbox-delete-confirm">Yes, delete</button>
                                <button type="button" class="btn btn-sm btn-outline-light" id="cartoon-lightbox-delete-cancel">Cancel</button>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="cartoon-lightbox-prev" class="cartoon-lightbox-nav cartoon-lightbox-nav-prev" aria-label="Previous">
                        <svg aria-hidden="true"><use href="#i-prev"></use></svg>
                    </button>
                    <button type="button" id="cartoon-lightbox-next" class="cartoon-lightbox-nav cartoon-lightbox-nav-next" aria-label="Next">
                        <svg aria-hidden="true"><use href="#i-next"></use></svg>
                    </button>

                    <div class="ka-viewer-sheet">
                        <div class="flex-grow-1" style="min-width:0">
                            <span id="cartoon-lightbox-error" class="small me-auto"></span>
                            @* Clamped to two lines until clicked - a long caption should not
                               cover the drawing it is describing. *@
                            <p id="cartoon-lightbox-description" class="ka-viewer-caption is-clamped mb-1"></p>
                            <div id="cartoon-lightbox-tags" class="ka-chips"></div>
                        </div>
                    </div>

                    @* Editing panels slide up over the sheet instead of occupying a
                       permanent sidebar next to the drawing. *@
                    <div id="cartoon-lightbox-edit-form" class="ka-viewer-panel d-none">
                        <label class="form-label small mb-1" for="cartoon-lightbox-edit-text">Description</label>
                        <textarea id="cartoon-lightbox-edit-text" class="form-control form-control-sm mb-2" rows="5"></textarea>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" id="cartoon-lightbox-edit-save">Save</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="cartoon-lightbox-edit-cancel">Cancel</button>
                        </div>
                    </div>

                    <div id="cartoon-lightbox-regen-form" class="ka-viewer-panel d-none">
                        <label class="form-label small mb-1" for="cartoon-lightbox-regen-lang">Regenerate in</label>
                        <select id="cartoon-lightbox-regen-lang" class="form-select form-select-sm mb-2">
                            <option value="tr">Türkçe</option>
                            <option value="en">English</option>
                            <option value="de">Deutsch</option>
                            <option value="fr">Français</option>
                            <option value="es">Español</option>
                        </select>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" id="cartoon-lightbox-regen-confirm">Regenerate</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="cartoon-lightbox-regen-cancel">Cancel</button>
                        </div>
                    </div>

                    <div id="cartoon-lightbox-tags-form" class="ka-viewer-panel d-none">
                        <label class="form-label small mb-1" for="cartoon-lightbox-tags-input">Tags</label>
                        <div id="cartoon-lightbox-tags-chips" class="d-flex flex-wrap gap-1 mb-2"></div>
                        <div class="position-relative mb-2">
                            <input type="text" id="cartoon-lightbox-tags-input"
                                   class="form-control form-control-sm"
                                   placeholder="Type a tag, Enter to add…" autocomplete="off">
                            <div id="cartoon-lightbox-tags-suggest" class="dropdown-menu shadow-sm w-100"
                                 style="max-height: 12rem; overflow-y: auto;"></div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" id="cartoon-lightbox-tags-save">Save</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="cartoon-lightbox-tags-cancel">Cancel</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => { /* non-fatal */ });
            });
        }
    </script>
</body>
</html>
