<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Karikatür Arşivi</title>
    <script>
        // Apply theme before render to avoid FOUC.
        (function () {
            var stored = localStorage.getItem('theme');
            var theme = stored ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CartoonArchive.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0d6efd" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Karikatür Arşivi</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Upload">Upload</a>
                        </li>
                    </ul>
                    <form class="d-flex ms-auto me-2" role="search" asp-page="/Search" method="get">
                        <input class="form-control me-2" type="search" name="q"
                               placeholder="Search captions…" aria-label="Search"
                               value="@Context.Request.Query["q"]">
                        <button class="btn btn-outline-primary" type="submit">Search</button>
                    </form>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="theme-toggle" aria-label="Toggle theme">
                        <span id="theme-icon">🌙</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 - Karikatür Arşivi</span>
            <span class="small">v@(AppInfo.Version)</span>
        </div>
    </footer>

    <div class="modal fade" id="cartoon-lightbox" tabindex="-1"
         aria-labelledby="cartoon-lightbox-title" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cartoon-lightbox-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <img id="cartoon-lightbox-image" class="img-fluid rounded" alt="">
                        </div>
                        <div class="col-md-4">
                            <p class="mb-2">
                                <span class="badge bg-secondary" id="cartoon-lightbox-language"></span>
                            </p>
                            <p id="cartoon-lightbox-description" class="small mb-2"></p>
                            <div id="cartoon-lightbox-desc-controls" class="d-flex gap-3 mb-2 small">
                                <button type="button" class="btn btn-link btn-sm p-0" id="cartoon-lightbox-edit">Edit</button>
                                <button type="button" class="btn btn-link btn-sm p-0" id="cartoon-lightbox-regen">Regenerate</button>
                            </div>
                            <div id="cartoon-lightbox-edit-form" class="d-none mb-2">
                                <textarea id="cartoon-lightbox-edit-text" class="form-control form-control-sm mb-2" rows="5"></textarea>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm" id="cartoon-lightbox-edit-save">Save</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="cartoon-lightbox-edit-cancel">Cancel</button>
                                </div>
                            </div>
                            <div id="cartoon-lightbox-regen-form" class="d-none mb-2">
                                <label class="form-label small mb-1" for="cartoon-lightbox-regen-lang">Regenerate in:</label>
                                <select id="cartoon-lightbox-regen-lang" class="form-select form-select-sm mb-2">
                                    <option value="tr">Türkçe</option>
                                    <option value="en">English</option>
                                    <option value="de">Deutsch</option>
                                    <option value="fr">Français</option>
                                    <option value="es">Español</option>
                                </select>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm" id="cartoon-lightbox-regen-confirm">Regenerate</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="cartoon-lightbox-regen-cancel">Cancel</button>
                                </div>
                            </div>
                            <p class="text-muted small mb-0" id="cartoon-lightbox-uploaded"></p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <span id="cartoon-lightbox-error" class="text-danger small me-auto"></span>
                    <div id="cartoon-lightbox-actions" class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary" id="cartoon-lightbox-share">Share</button>
                        <button type="button" class="btn btn-outline-danger" id="cartoon-lightbox-delete">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                    <div id="cartoon-lightbox-confirm" class="d-none align-items-center gap-2">
                        <span class="text-muted small">Really delete?</span>
                        <button type="button" class="btn btn-danger" id="cartoon-lightbox-delete-confirm">Yes, delete</button>
                        <button type="button" class="btn btn-secondary" id="cartoon-lightbox-delete-cancel">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
        <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => { /* non-fatal */ });
            });
        }
    </script>
</body>
</html>
