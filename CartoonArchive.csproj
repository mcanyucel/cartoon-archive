<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4fe6c41e-9978-4b43-af96-c74f1f6906ca</UserSecretsId>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project lives at the repo root, so the SDK's default **/*.cs glob would
         otherwise pull the test project's sources into the web assembly. -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal members (BuildFtsMatch, IsPrivateOrLocal,
         StripFingerprint) without widening the public API surface. -->
    <InternalsVisibleTo Include="CartoonArchive.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.0" />
    <!-- Pinned directly to override vulnerable transitive from EF Core Sqlite. See NU1903 / GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
